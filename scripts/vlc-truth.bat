@echo off
REM vlc-truth.bat — open VLC with github.io as its source of truth.
REM
REM VLC reads the playlist FROM the deployed surface, not from a local folder
REM listing. The playlist is generated by probing each URL, so an entry cannot
REM exist in it unless it answered HTTP 200 — VLC's view matches reality.
REM
REM   vlc-truth.bat            open the whole truth playlist
REM   vlc-truth.bat --refresh  regenerate the playlist first, then open it
REM   vlc-truth.bat status     what is VLC playing, and how many entries
REM   vlc-truth.bat verify     re-probe every entry; report any that died

setlocal
set VLC="C:\Program Files\VideoLAN\VLC\vlc.exe"
set PLAYLIST=https://myaelmendez.github.io/playlist.m3u
set PY=C:\Users\yaelm\AppData\Local\hermes\hermes-agent\venv\Scripts\python.exe
set TRUTH=C:\æ\agents\vlc_truth.py

if /i "%~1"=="--refresh" goto refresh
if /i "%~1"=="status"    goto status
if /i "%~1"=="verify"    goto verify

:open
echo Opening VLC with the truth playlist:
echo   %PLAYLIST%
start "" %VLC% --playlist-enqueue %PLAYLIST%
goto :eof

:refresh
echo Regenerating the playlist (probing every URL)...
"%PY%" "%TRUTH%" build
if errorlevel 1 (
  echo.
  echo   The build failed. The playlist on the surface is unchanged.
  echo   Nothing was opened.
  goto :eof
)
echo.
echo Deploying the regenerated playlist...
pushd C:\æ\github-pages
git add playlist.m3u
git -c user.name="Yael Mendez" -c user.email="yael@llm.store" commit -q -m "playlist: regenerate from the probed truth surface"
git -c http.sslBackend=openssl -c http.version=HTTP/1.1 pull --rebase origin gh-pages
git -c http.sslBackend=openssl -c http.version=HTTP/1.1 -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 push origin HEAD:gh-pages
popd
goto open

:status
"%PY%" "%TRUTH%" status
goto :eof

:verify
"%PY%" "%TRUTH%" verify
goto :eof
